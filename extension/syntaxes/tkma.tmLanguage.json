{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TKMA",
  "scopeName": "source.tkma",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.tkma"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.tkma"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.tkma"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(import|pub|class|if|else|while|for|return|let|var|fun|true|false|println|print)\\b",
          "name": "keyword.control.tkma"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.tkma"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.tkma"
        }
      ]
    }
  }
}
